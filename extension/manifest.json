{
  "manifest_version": 3,
  "name": "はこホム AF Lv4000予測",
  "version": "2.0.19",
  "description": "AFの現在値とLv4000予測値を並べて表示し、読み込まれた一覧を絞り込みます。",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://arkhomu.com/*"],
    "js": ["market-snapshot.js", "forecast.js", "artifact-effects.js", "list-rules.js", "hidden-titles.js", "extras-main.js", "read-af.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }, {
    "matches": ["https://arkhomu.com/*"],
    "js": ["forecast.js", "artifact-effects.js", "list-rules.js", "filter-popup.js", "enhance-estimate.js", "explore-analysis.js", "market-watch.js", "update-check.js", "desktop-update.js", "extras.js", "content.js"],
    "css": ["style.css"],
    "run_at": "document_idle"
  }]
}
